# Public URL of the site (used for metadata, sitemap and secure cookies)
APP_URL=http://localhost:3000
# Where the SQLite database and uploads live. Mount a persistent volume here in production.
DATA_DIR=./data
# Creator service fee in basis points (1000 = 10%)
PLATFORM_FEE_BPS=1000
# Gamepass URL players buy to deposit Robux (shown on the wallet page)
DEPOSIT_GAMEPASS_URL=
SUPPORT_EMAIL=support@creatorlink.example
# DEV ONLY: lets users add fake funds instantly. Never enable in production.
ENABLE_TEST_FUNDS=false
# If true, the very first account to sign up becomes an admin (use once to bootstrap, then remove).
FIRST_USER_IS_ADMIN=false
