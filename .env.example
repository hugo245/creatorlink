# ---------- Required in production ----------
# Public URL of the site (metadata, sitemap, reset-password links, secure cookies)
APP_URL=http://localhost:3000
# Postgres connection string. Leave EMPTY for local development (an embedded Postgres is used).
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
DATABASE_URL=

# ---------- File uploads (chat attachments, avatars) ----------
# Leave empty locally (files go to ./data/uploads). In production use a PRIVATE Supabase Storage bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads

# ---------- Email (password reset) ----------
# https://resend.com. Without these, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=CreatorLink <no-reply@yourdomain.com>

# ---------- USD payments (Stripe) ----------
# https://dashboard.stripe.com/apikeys  (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://YOURDOMAIN/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Card fee passed to the buyer on USD deposits (Stripe's standard US rate)
STRIPE_FEE_PERCENT=2.9
STRIPE_FEE_FIXED_CENTS=30
# Days before USD sale earnings become withdrawable (covers the chargeback window)
USD_PAYOUT_HOLD_DAYS=7
# Accounts younger than this can't withdraw
MIN_ACCOUNT_AGE_DAYS_FOR_PAYOUT=3

# ---------- Creator verification ----------
# YouTube Data API v3 key: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# true = creators with verified channels and no name flags are approved automatically
AUTO_APPROVE_VERIFIED_CREATORS=false

# ---------- Business settings ----------
# Rough USD value of 1 Robux, used only to sort/filter prices across currencies
ROBUX_USD_RATE=0.0035
# Creator service fee in basis points (1000 = 10%)
PLATFORM_FEE_BPS=1000
# Gamepass players buy to deposit Robux (shown on the wallet page)
DEPOSIT_GAMEPASS_URL=
SUPPORT_EMAIL=support@creatorlink.example

# ---------- Operations ----------
# Protects /api/cron/sweep. Generate with: openssl rand -hex 32
CRON_SECRET=
# One-time bootstrap: the first account to sign up becomes admin. Remove after creating your admin.
FIRST_USER_IS_ADMIN=false
# DEV ONLY: instant fake funds. NEVER enable in production.
ENABLE_TEST_FUNDS=false
