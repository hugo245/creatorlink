/** Writes supabase/schema.sql from src/lib/schema.ts: `npm run schema` */
import { writeFileSync } from 'node:fs';
import { MIGRATIONS } from '../src/lib/schema';

const header = `-- CreatorLink database schema (generated by \`npm run schema\`; do not edit by hand).
-- The app applies this automatically on first start. Run it manually in the Supabase SQL editor only if you
-- prefer to create the tables yourself, then also run the last statement so the app knows it's applied.\n\n`;
const body = MIGRATIONS.map((m) => m.trim().replace(/^ {2}/gm, '')).join('\n\n');
const footer = `\n\nCREATE TABLE IF NOT EXISTS schema_migrations (version INTEGER PRIMARY KEY, applied_at BIGINT NOT NULL);\nALTER TABLE schema_migrations ENABLE ROW LEVEL SECURITY;\nINSERT INTO schema_migrations (version, applied_at) VALUES (1, (extract(epoch from now()) * 1000)::bigint) ON CONFLICT DO NOTHING;\n`;
writeFileSync('supabase/schema.sql', header + body + footer);
console.log('Wrote supabase/schema.sql');
